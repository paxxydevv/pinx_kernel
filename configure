#!/bin/sh
#
# Pinx kernel configure script.
#
# Reads the options declared in ./Kconfig and writes include/generated/config.h.
# Deliberately not GNU autoconf: there are a handful of options and a few
# hundred lines of shell is easier to audit than generated configure output.
#
# Usage:
#   ./configure                      prompt for every option (needs a terminal)
#   ./configure --enable-DEBUG       non-interactive, everything else default
#   ./configure --disable-DEBUG
#   ./configure --help
#
# An option is either named on the command line or it is at its Kconfig
# default. Nothing is inherited from a previous run, so the result depends only
# on the command line and ./Kconfig. `make distclean` throws the generated
# files away.

set -eu

srcdir=$(dirname "$0")
KCONFIG="$srcdir/Kconfig"
OUTDIR="$srcdir/include/generated"
OUTFILE="$OUTDIR/config.h"
OUTMK="$OUTDIR/config.mk"
CACHE="$OUTDIR/config.cache"

die() {
    echo "configure: error: $*" >&2
    exit 1
}

[ -f "$KCONFIG" ] || die "Kconfig not found in $srcdir"

# ---------------------------------------------------------------- parse Kconfig
#
# Emits one "NAME|TYPE|PROMPT|DEFAULT|VALUES|DEPS|ALIASES" line per option. The
# Kconfig grammar we support is a small subset on purpose:
#
#   config NAME
#       bool   "prompt text"      yes/no
#       string "prompt text"      has a word value
#       default y|n|<word>
#       values  a b c             allowed words, string options only
#       option  a b               extra CLI spellings for --name=value
#       depends on OTHER
#
# Anything else is ignored, so the help text can say whatever it likes.

parse_kconfig() {
    awk '
        function flush() {
            if (name != "") {
                printf "%s|%s|%s|%s|%s|%s|%s\n", name, type, prompt, def, vals, deps, alias
                name = ""; type = "bool"; prompt = ""; def = "n"
                vals = "-"; deps = ""; alias = "-"
            }
        }
        /^[[:space:]]*#/ { next }
        /^config[[:space:]]+/ {
            flush()
            name = $2
            type = "bool"
            prompt = name
            def = "n"
            vals = "-"
            deps = ""
            alias = "-"
            next
        }
        /^[[:space:]]*bool[[:space:]]/ {
            type = "bool"
            if (match($0, /"[^"]*"/)) {
                prompt = substr($0, RSTART + 1, RLENGTH - 2)
            }
            next
        }
        /^[[:space:]]*string[[:space:]]/ {
            type = "string"
            if (match($0, /"[^"]*"/)) {
                prompt = substr($0, RSTART + 1, RLENGTH - 2)
            }
            next
        }
        /^[[:space:]]*default[[:space:]]+/ {
            # A bool default is y or n; a string default is any word. The
            # option type decides how this is validated later.
            def = $2
            next
        }
        /^[[:space:]]*values[[:space:]]+/ {
            line = $0
            sub(/^[[:space:]]*values[[:space:]]+/, "", line)
            gsub(/[[:space:]]+/, " ", line)
            vals = line
            next
        }
        /^[[:space:]]*option[[:space:]]+/ {
            line = $0
            sub(/^[[:space:]]*option[[:space:]]+/, "", line)
            gsub(/[[:space:]]+/, " ", line)
            alias = line
            next
        }
        /^[[:space:]]*depends[[:space:]]+on[[:space:]]+/ {
            deps = $3
            next
        }
        END { flush() }
    ' "$KCONFIG"
}

OPTIONS=$(parse_kconfig)
[ -n "$OPTIONS" ] || die "no options found in Kconfig"

# The option list is newline separated but the prompts contain spaces, so it
# has to be read field by field rather than with `for x in $OPTIONS`, which
# would word split every prompt into its own bogus iteration.
OPTFILE=$(mktemp "${TMPDIR:-/tmp}/pinx-configure.XXXXXX") || die "cannot create temp file"
trap 'rm -f "$OPTFILE"' EXIT INT TERM
printf '%s\n' "$OPTIONS" > "$OPTFILE"

# Is $2 one of the space separated words in $1? ("-" means "no constraint")
value_allowed() {
    [ "$1" = "-" ] && return 0
    for allowed in $1; do
        [ "$allowed" = "$2" ] && return 0
    done
    return 1
}

# Written for humans and for diffing, never read back: the precedence chain
# has no cache step, so configure is a pure function of (command line, Kconfig).
save_cache() {
    mkdir -p "$OUTDIR"
    : > "$CACHE"
    for name in $NAMES; do
        eval "value=\$$name"
        echo "$name=$value" >> "$CACHE"
    done
    chmod 644 "$CACHE"
}
# ---------------------------------------------------------------- arg handling

MODE=default
EXPLICIT=""
EXPLICIT_VALUES=""
want_help=0

# Validate a string option value early, so a typo fails at argument time rather
# than quietly producing a config.h that no longer matches the Makefile.
check_string_value() {
    # $1 = option name, $2 = value, $3 = allowed words
    if [ "$3" != "-" ] && ! value_allowed "$3" "$2"; then
        die "$1: '$2' is not one of: $3"
    fi
}

for arg in "$@"; do
    case "$arg" in
        -h|--help)
            want_help=1
            ;;
        --enable-*|--disable-*)
            MODE=explicit
            ename=$(printf '%s' "$arg" | tr 'a-z' 'A-Z')
            ename=${ename#--ENABLE-}
            ename=${ename#--DISABLE-}
            # Validate the name here. The string branch below does this, but
            # these two used to skip straight to the catch-all and record
            # whatever they were given, so `--enable-smp` (or any typo) was
            # accepted and quietly did nothing. A flag that cannot fail is
            # worse than no flag: you think you enabled something.
            eline=$(awk -F'|' -v n="$ename" '$1 == n { print; exit }' "$OPTFILE")
            if [ -z "$eline" ]; then
                die "unknown option: $arg (try --help)"
            fi
            etype=$(printf '%s' "$eline" | cut -d'|' -f2)
            if [ "$etype" != bool ]; then
                die "$ename is a string option; use --$ename=<value>, not $arg"
            fi
            case "$arg" in
                --enable-*) EXPLICIT="$EXPLICIT $ename" ;;
                *)          EXPLICIT="$EXPLICIT -$ename" ;;
            esac
            ;;
        # --name=value sets a string option. The name is matched
        # case-insensitively, and may be either the symbol name or one of the
        # aliases declared with `option` in Kconfig, so both --profile and
        # --log-level work.
        --*=*)
            MODE=explicit
            sname=$(printf '%s' "${arg%%=*}" | tr 'a-z' 'A-Z')
            sname=${sname#--}
            svalue=${arg#*=}
            # An alias wins over a same-named symbol, so resolve aliases first.
            resolved=$(awk -F'|' -v want="$sname" '
                { n = toupper($1); a = $7
                  if (a != "-") {
                    m = split(a, words, " ")
                    for (i = 1; i <= m; i++)
                      if (toupper(words[i]) == want) { print $1; found = 1; exit }
                  }
                }
                END { if (!found) exit 1 }
            ' "$OPTFILE" 2>/dev/null || true)
            if [ -n "$resolved" ]; then
                sname=$resolved
            fi
            sline=$(awk -F'|' -v n="$sname" '$1 == n { print; exit }' "$OPTFILE")
            if [ -z "$sline" ]; then
                die "unknown option: --$sname (try --help)"
            fi
            stype=$(printf '%s' "$sline" | cut -d'|' -f2)
            if [ "$stype" != string ]; then
                die "--$sname takes no value; use --enable-$sname / --disable-$sname"
            fi
            svals=$(printf '%s' "$sline" | cut -d'|' -f5)
            check_string_value "$sname" "$svalue" "$svals"
            EXPLICIT_VALUES="$EXPLICIT_VALUES $sname=$svalue"
            ;;
        --*)
            die "unknown option: $arg (try --help)"
            ;;
        *)
            die "unexpected argument: $arg (try --help)"
            ;;
    esac
done

if [ "$want_help" -eq 1 ]; then
    cat <<'EOF'
Usage: ./configure [options]

  --enable-OPTION     set a yes/no OPTION to y
  --disable-OPTION    set a yes/no OPTION to n
  --name=value        set a string OPTION (matched case-insensitively)
  --help              show this text

With no options, every value is taken from the previous run, or from the
Kconfig defaults the first time around. When stdin is a terminal you are
prompted for each option instead.

Options declared in ./Kconfig:
EOF
    echo "$OPTIONS" | while IFS='|' read -r name type prompt def vals deps alias; do
        case "$type" in
            string)
                # Show the alias when there is one, since that is the nicer
                # spelling: --log-level rather than --default_log_level.
                shown=$(printf '%s' "$name" | tr 'A-Z' 'a-z')
                case "$alias" in
                    -|"") ;;
                    *) shown=$(printf '%s' "$alias" | cut -d" " -f1) ;;
                esac
                printf '  --%-20s %s (%s) [%s]\n' "$shown" "$prompt" "$vals" "$def"
                ;;
            *)      printf '  %-22s %s [%s]\n' "$name" "$prompt" "$def" ;;
        esac
    done
    exit 0
fi

interactive=0
if [ "$MODE" = default ] && [ -t 0 ]; then
    interactive=1
fi

# ---------------------------------------------------------------- apply values


# Seed every option so the `depends on` lookups below never hit an unset
# variable, which `set -u` would treat as fatal.
#
# The option list is read on fd 3, never on fd 0. A `while ... done < file`
# redirect covers the loop *body* too, so a `read` inside the body would eat
# the next line of the option list instead of the answer, and the remaining
# options would silently never be offered. Keeping fd 0 as the terminal lets
# the prompts below read the keyboard. fd 3 is re-opened before each pass
# because a `while read` leaves it at EOF.
NAMES=""
exec 3< "$OPTFILE"
while IFS='|' read -r name type prompt def vals deps alias <&3; do
    case "$type" in
        string) eval "$name=$def" ;;
        *)      eval "$name=n" ;;
    esac
    NAMES="$NAMES $name"
done

exec 3< "$OPTFILE"
while IFS='|' read -r name type prompt def vals deps alias <&3; do
    # Precedence: explicit command line > Kconfig default.
    #
    # There is deliberately no third step. configure used to fall back to
    # config.cache, which meant an option you did not name on the command line
    # kept whatever the last run happened to pick -- so `./configure
    # --enable-DEBUG` silently inherited a stale `--disable-LOG_TAGS` from
    # three runs ago. An option is either set here or it is at its default;
    # nothing is inherited. See the note on the cache file below.
    value=""
    case " $EXPLICIT " in
        *" $name "*)  value=y ;;
        *" -$name "*) value=n ;;
    esac
    if [ -z "$value" ]; then
        value=$def
    fi
    # A string option set with --name=value has to be picked up here rather
    # than through $EXPLICIT, which only carries bools.
    if [ "$type" = string ]; then
        for pair in $EXPLICIT_VALUES; do
            case "$pair" in
                "$name="*) value=${pair#*=} ;;
            esac
        done
    fi
    case "$type" in
        bool)
            case "$value" in y|n) ;; *) value=n ;; esac ;;
        string)
            # A value from the cache or Kconfig could be anything; clamp it to
            # the declared set rather than emitting a config the Makefile
            # cannot interpret.
            value_allowed "$vals" "$value" || value=$def
            ;;
    esac

    # Honour `depends on`: a disabled parent forces its children off. Only
    # meaningful for bools; a string parent is a value, not a yes/no.
    forced=""
    if [ -n "$deps" ] && [ "$type" != string ]; then
        eval "parent_value=\$$deps"
        if [ "$parent_value" != y ]; then
            value=n
            forced="$deps"
        fi
    fi

    if [ "$interactive" -eq 1 ]; then
        if [ -n "$forced" ]; then
            # Kconfig hides options whose parent is off, so do not ask. Asking
            # would be a trap: the answer could not be honoured.
            printf '%s [n] (forced off, requires %s)\n' "$prompt" "$forced" >&2
        elif [ "$type" = string ]; then
            while :; do
                printf '%s (%s) [%s] ' "$prompt" "$vals" "$value" >&2
                if read -r answer; then
                    case "$answer" in
                        "") break ;;
                        *)
                            if value_allowed "$vals" "$answer"; then
                                value=$answer
                                break
                            fi
                            echo "configure: please answer one of: $vals" >&2
                            ;;
                    esac
                else
                    break
                fi
            done
        else
            while :; do
                printf '%s [%s] (y/n) ' "$prompt" "$value" >&2
                if read -r answer; then
                    case "$answer" in
                        y|Y|yes|YES)  value=y; break ;;
                        n|N|no|NO)   value=n; break ;;
                        # Bare Enter keeps the default, which the prompt shows.
                        "")          break ;;
                        *)           echo "configure: please answer y or n" >&2 ;;
                    esac
                else
                    # EOF: keep the default rather than looping forever.
                    break
                fi
            done
        fi
    fi

    # Re-assert `depends on` after prompting. Without this, answering y to a
    # child of a disabled parent would emit CONFIG_FOO 1 alongside
    # CONFIG_PARENT 0, and the child's #if would win in the header.
    if [ -n "$deps" ] && [ "$type" != string ]; then
        eval "parent_value=\$$deps"
        if [ "$parent_value" != y ]; then
            value=n
        fi
    fi

    eval "$name=\$value"
done

# ------------------------------------------------- emit config.h and config.mk
#
# Two files, because the two consumers disagree on syntax:
#
#   config.h  for the C code. Strings become "value", bools become 1 or 0.
#   config.mk  for the Makefile. GNU make ignores '#define' lines entirely --
#             they are comments to it -- so a Makefile that wants to branch on
#             CONFIG_PROFILE cannot read config.h and needs a real
#             'NAME := value' assignment.

mkdir -p "$OUTDIR"

exec 3< "$OPTFILE"
{
    echo "/* Generated by ./configure from Kconfig. Do not edit by hand;"
    echo " * run ./configure instead. */"
    echo "#pragma once"
    echo ""
    while IFS='|' read -r name type prompt def vals deps alias <&3; do
        eval "value=\$$name"
        if [ "$type" = string ]; then
            echo "#define CONFIG_$name \"$value\""
        elif [ "$value" = y ]; then
            echo "#define CONFIG_$name 1"
        else
            echo "#define CONFIG_$name 0"
        fi
        echo "/* $prompt */"
    done
} > "$OUTFILE.new"

exec 3< "$OPTFILE"
{
    echo "# Generated by ./configure from Kconfig. Do not edit by hand."
    echo "# Read by the Makefile with '-include'."
    while IFS='|' read -r name type prompt def vals deps alias <&3; do
        eval "value=\$$name"
        if [ "$type" = string ]; then
            echo "CONFIG_$name := $value"
        elif [ "$value" = y ]; then
            echo "CONFIG_$name := 1"
        else
            echo "CONFIG_$name := 0"
        fi
    done
} > "$OUTMK.new"

mv "$OUTFILE.new" "$OUTFILE"
mv "$OUTMK.new" "$OUTMK"
chmod 644 "$OUTFILE" "$OUTMK"
save_cache

echo "configure: wrote $OUTFILE"
exec 3< "$OPTFILE"
while IFS='|' read -r name type prompt def vals deps alias <&3; do
    eval "value=\$$name"
    printf '  CONFIG_%-20s = %s\n' "$name" "$value"
done
echo "configure: run 'make' to build"
