# Pinx kernel build configuration
#
# This file is the single source of truth for compile-time options. Run
# ./configure to pick values, or pass flags directly:
#
#   ./configure
#   ./configure --disable-DEBUG
#   ./configure --enable-DEBUG --disable-DEBUG_PCI
#   ./configure --profile=release
#   ./configure --log-level=debug
#
# ./configure writes include/generated/config.h for the C code and
# include/generated/config.mk for the Makefile. Nothing else should hardcode
# these values.
#
# Grammar understood by ./configure (a small subset on purpose):
#
#   config NAME
#       bool   "prompt"        a yes/no option
#       string "prompt"        an option with a word value
#       default y|n|<word>
#       values  a b c          allowed words, for a string option
#       depends on OTHER       a disabled parent forces this off (bool only)
#
# Anything else is ignored, so help text can say whatever it likes.

mainmenu "Pinx kernel configuration"

config PROFILE
	string "Build profile"
	default debug
	values debug release
	help
	  Controls optimisation and debug info, not what gets compiled in.

	  debug   -O0, full debug info, assertions stay enabled. Use while
	           developing: stepping through paging code at -O2 is miserable.
	  release -O2, no debug info. Smaller and faster, but a crash becomes
	           much harder to read backtrace-free.

config DEBUG
	bool "Print kernel debug messages"
	default y
	help
	  Status and diagnostic messages such as "GDT: OK" or "PMM INIT: OK".

	  Turning this off compiles the messages out entirely: the strings are
	  not in the binary and the calls cost nothing at runtime. Error paths
	  and panic() are never compiled out and are unaffected by this.

	  This is the only way to shrink the binary. The runtime log level below
	  filters what is *printed*, but a message that is still compiled in
	  keeps its string in .rodata.

config DEBUG_PCI
	bool "Print every device found during PCI enumeration"
	default y
	depends on DEBUG
	help
	  Without this, pci_enumerate() stays silent unless something asks it
	  to report. Useful once a driver owns a device and you do not want
	  boot spam.

config DEBUG_HEAP
	bool "Print kernel heap allocation failures"
	default y
	depends on DEBUG
	help
	  kmalloc() already returns NULL on failure and the callers decide
	  what to do about it. This only controls whether a short allocation
	  is reported on screen before it is handled.

config LOG_TAGS
	bool "Tag each log line with its level"
	default y
	depends on DEBUG
	help
	  Prefixes lines with [trace], [debug], [info], [warn] or [error], so
	  you can still tell levels apart in a screenshot.

config DEFAULT_LOG_LEVEL
	string "Log level at boot"
	option log-level
	default info
	values trace debug info warn error none
	depends on DEBUG
	help
	  The runtime threshold, adjustable later without recompiling. Messages
	  below it are not printed.

	  Errors are exempt: KERROR is printed at every level except none, and
	  panic() always prints regardless.
